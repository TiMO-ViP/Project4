{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@project4/types": ["./packages/types/index.ts"],
      "@project4/config": ["./packages/config/index.ts"],
      "@project4/utils": ["./packages/utils/index.ts"]
    }
  },
  "include": ["src/**/*", "packages/**/*", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
