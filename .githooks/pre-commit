#!/usr/bin/env bash
# Native Git Hook: pre-commit
# Validates editorconfig formatting and secret scanning before allowing commit

set -e

echo "🔍 Running Pre-Commit Quality & Secret Checks..."

# Prevent commits containing raw unencrypted secrets, API tokens, or private keys
if git diff --staged | grep -qE 'BEGIN (RSA|OPENSSH|PRIVATE) KEY|ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{82}|AKIA[0-9A-Z]{16}|xox[baprs]-[0-9a-zA-Z]{10,}|sk_live_[0-9a-zA-Z]{24}'; then
  echo "❌ SECURITY BLOCK: Potential secret, API token, or private key detected in staged files!"
  echo "Remove credentials before committing."
  exit 1
fi

echo "✅ Pre-Commit Security Checks Passed Cleanly."
