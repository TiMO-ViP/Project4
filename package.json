{
  "name": "project4",
  "version": "1.0.0",
  "description": "Enterprise multi-stack project with Next.js 16, Supabase, Drizzle ORM, and TypeScript 7",
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm exec next dev",
    "build": "pnpm exec next build",
    "start": "pnpm exec next start",
    "test": "node --test .agents/scripts/run-tests.mjs",
    "lint": "pnpm exec biome check ./src",
    "format": "pnpm exec biome format --write ./src",
    "typecheck": "pnpm exec tsc --noEmit",
    "pipeline": "pnpm exec turbo run lint typecheck test",
    "db:generate": "pnpm exec drizzle-kit generate",
    "db:push": "pnpm exec drizzle-kit push",
    "db:studio": "pnpm exec drizzle-kit studio"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "supabase": "^2.114.0",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
