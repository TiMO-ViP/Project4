{
  "name": "project4",
  "version": "1.0.0",
  "description": "Enterprise multi-stack project with Next.js 16, Supabase, Drizzle ORM, and TypeScript",
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test .agents/scripts/run-tests.mjs",
    "lint": "biome check ./src",
    "format": "biome format --write ./src",
    "typecheck": "tsc --noEmit",
    "pipeline": "turbo run lint typecheck test",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "supabase": "^2.113.0",
    "turbo": "^2.4.4",
    "typescript": "^7.0.2",
    "vitest": "^3.0.5"
  }
}
